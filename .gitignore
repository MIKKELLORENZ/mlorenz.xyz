*.keras
*.pyc
vibe-code/games/mall_walk/generate-cert.ps1
vibe-code/games/mall_walk/key.pem
vibe-code/games/mall_walk/cert.pem

# Sound candidates (bulk downloaded for selection)
vibe-code/shared_assets/audio/candidates/

vibe-code/games/just_a_man/

# Training scratch. Every neuro-evolution sim writes its run logs, checkpoints,
# island snapshots and A/B side-runs into a training/ folder next to the sim.
# It is regenerated on demand by that sim's trainer and is only useful for
# --resume on the machine that produced it (~155 MB across the sims so far).
# The champion that actually ships is baked into default_brain.js, which IS
# committed, so a fresh clone runs with no training/ directory at all.
training/

# Run logs and process bookkeeping, wherever they land.
*.log
*.err
*.out
*.pid

# SSH tunnels to the private training node. These describe personal
# infrastructure (host, forwarded ports, NAT layout) and are useless to anyone
# else cloning this repo, which is published as a public site.
dashboard_tunnel*.cmd

# Launchers for that same node. They carry its absolute home paths, its user
# account and the exact worker/port layout of runs on it — again personal
# infrastructure, and unusable anywhere else since they cd into a directory that
# only exists there. Globbed rather than listed one by one so the next A/B
# launcher is covered the day it is written instead of the day it is noticed.
relaunch*.sh
lidar_watch.sh

# Remaining launchers and sync helpers for the private training node. Same
# reasoning as relaunch*.sh above: they hardcode its ssh alias, its /data tree
# and (in autopick.sh) an absolute path on this Windows box, none of which mean
# anything to someone cloning the public site.
pull_champion.sh
autopick.sh
autosync.js
dashboard_sync.js
bake_and_verify.sh

# Overnight A/B scratch, the same category as training/ — checkpoints and
# side-run bookkeeping written next to the sim that produced them.
night/

# Local tooling. .claude/settings.local.json and the .vscode files record this
# machine's absolute paths and per-machine tool approvals.
**/.claude/settings.local.json
**/.claude/settings.json
**/.vscode/settings.json

# Installed dependencies — regenerated by `npm install` from package.json.
node_modules/

# Keys, certificates and credentials of any kind. The mall_walk localhost pair
# is already named above; this catches the next one before it is noticed.
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
.env
.env.*
.netrc
.npmrc

# Zip archives. These are local backups of sim folders that are already
# committed (tetris_neuro_evolution.zip was 249 MB, over GitHub's 100 MB file
# limit and rejected on push). Nothing on the site serves a committed zip;
# Everdiff builds its export zip in the browser. To commit one on purpose,
# use `git add -f`.
*.zip
